# ============================================
# MO Receiver Website - Environment Variables
# ============================================
# Copy this file to .env and update with your actual values
# Command: cp env.example .env
# DO NOT commit .env file to git repository

# ============================================
# Application Configuration
# ============================================
PORT=4001
HOST=0.0.0.0
NODE_ENV=production

# Authentication Token (for API endpoint /api/mo/receive)
# Generate a strong random token for production
# Example: openssl rand -hex 32
AUTH_TOKEN=your_secret_token_here_change_this_in_production

# ============================================
# Database Configuration
# ============================================
# Choose database type: 'sqlite' or 'postgresql'
DB_TYPE=postgresql

# SQLite Configuration (if DB_TYPE=sqlite)
# Uncomment below if using SQLite
# DB_PATH=./kmi_receiver.db

# PostgreSQL Configuration (if DB_TYPE=postgresql)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=kmi_receiver
DB_USER=admin
DB_PASSWORD=admin123

# ============================================
# Optional: Logging Configuration
# ============================================
# LOG_LEVEL=info  # debug, info, warn, error
