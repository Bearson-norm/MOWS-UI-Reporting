# ============================================
# MO Receiver Website - Environment Variables
# ============================================
# Copy this file to .env and update with your actual values
# Command: cp env.example .env
# DO NOT commit .env file to git repository

# ============================================
# Application Configuration
# ============================================
PORT=4001
HOST=0.0.0.0
NODE_ENV=production

# Authentication Token (for API endpoint /api/mo/receive)
# Generate a strong random token for production
# Example: openssl rand -hex 32
AUTH_TOKEN=your_secret_token_here_change_this_in_production

# UI Login (seeded on first run if no users exist)
# User from ADMIN_USERNAME automatically receives role 'admin'
# IMPORTANT: Set strong credentials before production deploy
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_password

# Session expiry for UI login (hours)
SESSION_EXPIRY_HOURS=24

# Note for VPS deploy:
# - Place .env in website/ OR parent deploy folder (e.g. /opt/mo-reporting/.env)
# - After first deploy with login feature, restart PM2: pm2 restart mo-receiver-kmi
# - Existing database is migrated automatically on startup (users, roles, app_settings)

# ============================================
# Database Configuration
# ============================================
# Choose database type: 'sqlite' or 'postgresql'
DB_TYPE=postgresql

# SQLite Configuration (if DB_TYPE=sqlite)
# Uncomment below if using SQLite
# DB_PATH=./kmi_receiver.db

# PostgreSQL Configuration (if DB_TYPE=postgresql)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=kmi_receiver
DB_USER=admin
DB_PASSWORD=admin123

# ============================================
# Optional: Logging Configuration
# ============================================
# LOG_LEVEL=info  # debug, info, warn, error
